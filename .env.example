# Comma-separated frontend origins. Wildcards are not allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:5500
# Production example: ALLOWED_ORIGINS=https://your-frontend-domain.example
# Optional future AI service URL, for example https://smartcattle-ai.example.com
SMARTCATTLE_AI_URL=
# Shared key for the endpoints the AI service calls: POST /api/ai/events,
# PUT /api/ai/cameras/{id}/status and PUT /api/animals/{tag}/detection.
# Empty leaves those endpoints open; set it in production.
#
# NEVER put this in the frontend. VITE_ variables are public in the browser
# bundle, which is why browser-facing endpoints use a user token instead.
AI_API_KEY=
# PostgreSQL connection. Empty = in-memory storage (data lost on restart).
# Local example: DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/smartcattle
# Then create the tables with: alembic upgrade head
DATABASE_URL=
# Seconds without an AI status report before a camera is shown as offline (10-3600).
CAMERA_OFFLINE_AFTER_SECONDS=60

# --- Authentication ---
# Signs the access tokens. REQUIRED for authentication to work: while it is
# empty, /api/auth/* answers 503 and no endpoint is protected.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every existing token out.
JWT_SECRET=
# Access token lifetime in minutes (5-1440). There is no refresh token, so this
# is how long a session lasts.
ACCESS_TOKEN_MINUTES=60
# Failed logins per address before it is refused for LOGIN_LOCKOUT_SECONDS.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
