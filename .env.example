# Comma-separated frontend origins. Wildcards are not allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
# Optional future AI service URL, for example https://smartcattle-ai.example.com
SMARTCATTLE_AI_URL=
# Shared key the AI service sends to write events. Set this in production.
AI_API_KEY=
# Separate key required to read events and animals. Set this in production.
# Never embed it in browser code: anything the browser holds is public.
READ_API_KEY=

# Event storage backend: mysql (default) or memory.
# memory keeps events in RAM and loses them on restart; it needs no database.
EVENT_STORAGE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Leave empty only for a password-less local server.
MYSQL_PASSWORD=
MYSQL_DATABASE=smartcattle
# Connections kept open for the request threadpool.
MYSQL_POOL_SIZE=5
